---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Callout from '../../components/Callout';
import PromptBox from '../../components/PromptBox';
import Checklist from '../../components/Checklist';
import MetaBadge from '../../components/MetaBadge';
import PageNavigation from '../../components/PageNavigation.astro';

interface MissionItem {
  id: string;
  week: 1 | 2;
  day: string;
  title: string;
  duration: string;
  output: string;
  done: string[];
  links: { label: string; href: string }[];
}

const missions: MissionItem[] = [
  {
    id: 'scope',
    week: 1,
    day: '1일차',
    title: '아이디어 1개와 완료 기준 정하기',
    duration: '30분',
    output: 'README에 기능 1개, 완료 기준 5줄, 확인 방법 1개 작성',
    done: ['기능 범위를 핵심 동작 1개로 줄였다', '완료 기준 5줄을 작성했다', '확인할 명령어 또는 URL 기준을 정했다'],
    links: [
      { label: '60분 완주 시작', href: '/path/60min' },
      { label: 'HTTP/API 기초', href: '/map/http-api' },
    ],
  },
  {
    id: 'frontend',
    week: 1,
    day: '2-3일차',
    title: '프론트엔드 화면 골격 만들기',
    duration: '90분',
    output: '목록, 입력폼, 상세 화면 중 2개 이상이 로컬에서 동작',
    done: ['`npm run dev`가 정상 실행된다', '입력값과 목록이 화면에 보인다', '핵심 화면 스크린샷 1장을 남겼다'],
    links: [
      { label: 'React 시작', href: '/start/60min/frontend/react' },
      { label: 'Vue 시작', href: '/start/60min/frontend/vue' },
    ],
  },
  {
    id: 'backend',
    week: 1,
    day: '4일차',
    title: '백엔드 API 골격 만들기',
    duration: '90분',
    output: '`/health`와 핵심 리소스 목록/생성 API',
    done: ['`GET /health`가 200으로 응답한다', '목록/생성 API가 동작한다', '에러 응답 형식을 하나로 맞췄다'],
    links: [
      { label: 'FastAPI 시작', href: '/start/60min/backend/fastapi' },
      { label: 'Hono 시작', href: '/start/60min/backend/hono' },
    ],
  },
  {
    id: 'connect',
    week: 1,
    day: '5일차',
    title: '화면과 API 연결 후 첫 배포하기',
    duration: '120분',
    output: '화면에서 실제 API 데이터를 불러오고 배포 URL 1개 확보',
    done: ['브라우저에서 실제 데이터가 보인다', '배포 URL에 접속할 수 있다', '배포가 실패하면 문제 해결 문서로 복구한다'],
    links: [
      { label: '연결 가이드', href: '/start/60min/connect' },
      { label: '배포 가이드', href: '/start/60min/deploy' },
      { label: '트러블슈팅', href: '/fix' },
    ],
  },
  {
    id: 'auth',
    week: 2,
    day: '8-9일차',
    title: '가장 작은 인증 흐름 추가하기',
    duration: '120분',
    output: '로그인/로그아웃 또는 세션 쿠키 흐름 1개 구현',
    done: ['로그인 성공과 실패 화면을 구분했다', '쿠키 또는 토큰 저장 방식을 정했다', '로그인이 필요한 화면 1개를 적용했다'],
    links: [
      { label: '인증 개요', href: '/map/auth' },
      { label: '쿠키 인증 레시피', href: '/recipes/add-auth-cookie' },
    ],
  },
  {
    id: 'quality',
    week: 2,
    day: '10일차',
    title: '테스트와 품질 점검하기',
    duration: '60분',
    output: '핵심 시나리오 테스트 1개 이상과 PR 셀프 리뷰',
    done: ['성공/실패 케이스를 테스트했다', '다시 깨질 수 있는 위험 1개를 기록했다', 'PR 체크리스트를 통과했다'],
    links: [
      { label: '테스트 기초', href: '/map/testing-basics' },
      { label: 'PR 품질 점검', href: '/recipes/review-pr-quality' },
    ],
  },
  {
    id: 'ops',
    week: 2,
    day: '11-12일차',
    title: '운영에 필요한 최소 설정하기',
    duration: '90분',
    output: '환경변수 분리, 오류 확인 순서, 되돌리는 방법 문서화',
    done: ['staging/prod 환경변수를 분리했다', '장애가 났을 때 확인할 순서 3단계를 작성했다', '되돌리는 방법 1개를 기록했다'],
    links: [
      { label: '환경변수 기초', href: '/map/env-basics' },
      { label: '모니터링', href: '/map/ops' },
      { label: '릴리즈/롤백 런북', href: '/map/ops/release-rollback' },
    ],
  },
  {
    id: 'demo',
    week: 2,
    day: '13-14일차',
    title: '데모 정리와 회고하기',
    duration: '60분',
    output: '배포 URL, API URL, 사용법, 알려진 문제를 1페이지로 정리',
    done: ['웹/API URL을 공유할 수 있다', '사용 시나리오를 3줄로 정리했다', '다음 개선 항목 3개를 작성했다'],
    links: [
      { label: '완료 단계', href: '/start/60min/complete' },
      { label: '예제 프로젝트', href: '/reference' },
    ],
  },
];

const checklistItems = missions.map((mission) => ({
  id: mission.id,
  label: `${mission.day} · ${mission.title}`,
  description: mission.output,
}));

const week1 = missions.filter((mission) => mission.week === 1);
const week2 = missions.filter((mission) => mission.week === 2);
---

<DocsLayout
  title="2주 완주 미션 (베타)"
  description="초보 개발자를 위한 실행형 로드맵: 14일 안에 배포 URL 1개를 완성합니다"
  currentPath="/path/mission"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <nav class="flex items-center gap-2 text-sm text-text-secondary mb-6" aria-label="현재 위치">
      <a href="/" class="hover:text-white transition-colors">홈</a>
      <span>/</span>
      <a href="/path" class="hover:text-white transition-colors">Path</a>
      <span>/</span>
      <span class="text-primary font-medium">2주 완주 미션</span>
    </nav>

    <header class="mb-8 pb-6 border-b border-border">
      <MetaBadge icon="clock" text="총 14일 · 하루 30~120분" />
      <h1 class="text-3xl md:text-4xl font-black text-white mb-4">2주 완주 미션</h1>
      <p class="text-text-secondary text-lg leading-relaxed">
        이 페이지는 초보자가 기술 목록을 훑는 데서 멈추지 않고, 하루에 하나씩 끝낼 수 있게 만든 베타 과정입니다.
        목표는 하나입니다. 14일 안에 접속 가능한 배포 URL을 가진 서비스 1개를 완성합니다.
      </p>
    </header>

    <section class="mb-10">
      <Callout client:load variant="info" title="사용 방법">
        <ul class="list-disc list-inside mt-2 text-sm space-y-1">
          <li>하루에 과제 1개만 수행하세요.</li>
          <li>각 미션은 "산출물"과 "완료 기준"을 충족하면 종료합니다.</li>
          <li>막히면 해당 미션 카드의 문제 해결/레시피 링크로 바로 이동하세요.</li>
        </ul>
      </Callout>
    </section>

    <section class="mb-10">
      <PromptBox
        client:load
        title="매일 시작할 때 쓰는 기본 프롬프트"
        description="같은 형식으로 질문하면 하루 과제의 범위가 흔들리지 않습니다."
        prompt={`너는 초보 개발자를 돕는 시니어 엔지니어다.
현재 내 과제는 Choorai 2주 완주 미션 중 하나이며, 목표는 오늘 과제를 끝내는 것이다.
아래 형식으로만 답해줘:
1) 지금 해야 할 작업 3개
2) 복붙 가능한 명령어/코드
3) 완료 기준 체크리스트
4) 실패했을 때 확인할 순서(최대 3단계)

모호한 설명 대신 바로 실행 가능한 결과만 제시해줘.`}
      />
    </section>

    <section class="mb-10">
      <Checklist
        client:load
        storageKey="mission-2week-v1"
        title="2주 완주 진행 현황"
        items={checklistItems}
      />
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-white mb-4">1주차: 첫 배포까지</h2>
      <div class="space-y-4">
        {week1.map((mission) => (
          <article class="p-5 bg-surface border border-border rounded-xl">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-2 py-0.5 bg-primary/15 text-primary text-xs font-bold rounded">{mission.day}</span>
              <h3 class="text-white font-bold">{mission.title}</h3>
              <span class="text-xs text-text-secondary">({mission.duration})</span>
            </div>

            <p class="text-text-secondary text-sm mb-3"><strong class="text-white">산출물:</strong> {mission.output}</p>

            <ul class="list-disc list-inside text-sm text-text-secondary space-y-1 mb-4">
              {mission.done.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-2">
              {mission.links.map((link) => (
                <a href={link.href} class="px-3 py-1.5 text-xs font-medium rounded-lg bg-background border border-border text-text-secondary hover:text-white hover:border-primary/40 transition-colors">
                  {link.label}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-white mb-4">2주차: 안정화와 데모 정리</h2>
      <div class="space-y-4">
        {week2.map((mission) => (
          <article class="p-5 bg-surface border border-border rounded-xl">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-2 py-0.5 bg-accent-purple/20 text-accent-purple text-xs font-bold rounded">{mission.day}</span>
              <h3 class="text-white font-bold">{mission.title}</h3>
              <span class="text-xs text-text-secondary">({mission.duration})</span>
            </div>

            <p class="text-text-secondary text-sm mb-3"><strong class="text-white">산출물:</strong> {mission.output}</p>

            <ul class="list-disc list-inside text-sm text-text-secondary space-y-1 mb-4">
              {mission.done.map((item) => (
                <li>{item}</li>
              ))}
            </ul>

            <div class="flex flex-wrap gap-2">
              {mission.links.map((link) => (
                <a href={link.href} class="px-3 py-1.5 text-xs font-medium rounded-lg bg-background border border-border text-text-secondary hover:text-white hover:border-primary/40 transition-colors">
                  {link.label}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <Callout client:load variant="tip" title="이 과정이 기존 Map과 다른 점">
        <ul class="list-disc list-inside mt-2 text-sm space-y-1">
          <li>기술 주제가 아니라 완성 산출물 중심으로 순서가 고정됩니다.</li>
          <li>각 단계의 종료 조건이 명확해서 중간에 멈추기 어렵습니다.</li>
          <li>실패했을 때 바로 이동할 문제 해결/레시피 문서를 포함합니다.</li>
        </ul>
      </Callout>
    </section>

    <PageNavigation currentPath="/path/mission" />
  </div>
</DocsLayout>
