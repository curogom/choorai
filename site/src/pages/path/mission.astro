      { label: '릴리즈/롤백 런북', href: '/map/ops/release-rollback' },
      { label: 'Gateway Timeout', href: '/fix/gateway-timeout' },
    ],
  },
  {
    id: 'demo-package',
    week: 2,
    day: '13일차',
    title: '데모 문서 정리하기',
    duration: '60분',
    goal: '누군가에게 공유해도 바로 써볼 수 있게 URL과 사용법을 한 페이지로 정리합니다.',
    starterPrompt: '내 서비스 데모 문서를 만들고 싶어. 웹 URL, API URL, 사용 시나리오, 알려진 문제, 확인 방법을 1페이지 형식으로 정리해줘.',
    steps: [
      '웹 URL과 API URL을 맨 위에 적습니다.',
      '사용 시나리오를 3줄로 정리합니다.',
      '알려진 문제와 확인 방법을 적습니다.',
    ],
    output: '배포 URL, API URL, 사용법, 알려진 문제를 1페이지로 정리',
    done: ['웹/API URL을 공유할 수 있다', '사용 시나리오를 3줄로 정리했다', '알려진 문제와 확인 방법을 적었다'],
    validation: '다른 브라우저 또는 시크릿 창에서 데모 문서의 URL을 그대로 열어 확인합니다.',
    links: [
      { label: '완료 단계', href: '/start/60min/complete' },
      { label: '예제 프로젝트', href: '/reference' },
    ],
  },
  {
    id: 'retro',
    week: 2,
    day: '14일차',
    title: '회고하고 다음 개선 3개 고르기',
    duration: '60분',
    goal: '완성한 결과를 기준으로 다음에 고칠 것 3개만 고르고 2주 과정을 닫습니다.',
    starterPrompt: '내 2주 완주 결과를 회고하고 싶어. 잘 된 점, 막혔던 점, 다음 개선 3개, 버리지 말아야 할 기능 1개를 간단히 정리해줘.',
    steps: [
      '잘 된 점과 막혔던 점을 각각 3줄로 씁니다.',
      '다음 개선 항목을 3개만 고릅니다.',
      '이번 버전에서 유지할 핵심 기능 1개를 정합니다.',
    ],
    output: '회고 1페이지와 다음 개선 항목 3개',
    done: ['잘 된 점과 막힌 점을 정리했다', '다음 개선 항목 3개를 골랐다', '완성 URL과 회고 문서를 함께 보관했다'],
    validation: 'README 또는 회고 문서에 배포 URL과 다음 개선 3개가 함께 있는지 확인합니다.',
    links: [
      { label: '완료 단계', href: '/start/60min/complete' },
      { label: '예제 프로젝트', href: '/reference' },
    ],
  },
];

const checklistItems = missions.map((mission) => ({
  id: mission.id,
  label: `${mission.day} · ${mission.title}`,
  description: mission.output,
}));

const week1 = missions.filter((mission) => mission.week === 1);
const week2 = missions.filter((mission) => mission.week === 2);
---

<DocsLayout
  title="2주 완주 미션 (베타)"
  description="초보 개발자를 위한 실행형 로드맵: 14일 안에 배포 URL 1개를 완성합니다"
  currentPath="/path/mission"
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-8">
    <nav class="flex items-center gap-2 text-sm text-text-secondary mb-6" aria-label="현재 위치">
      <a href="/" class="hover:text-white transition-colors">홈</a>
      <span>/</span>
      <a href="/path" class="hover:text-white transition-colors">Path</a>
      <span>/</span>
      <span class="text-primary font-medium">2주 완주 미션</span>
    </nav>

    <header class="mb-8 pb-6 border-b border-border">
      <MetaBadge icon="clock" text="총 14일 · 하루 30~120분" />
      <h1 class="text-3xl md:text-4xl font-black text-white mb-4">2주 완주 미션</h1>
      <p class="text-text-secondary text-lg leading-relaxed">
        이 페이지는 초보자가 기술 목록을 훑는 데서 멈추지 않고, 하루에 하나씩 끝낼 수 있게 만든 베타 과정입니다.
        목표는 하나입니다. 14일 안에 접속 가능한 배포 URL을 가진 서비스 1개를 완성합니다.
      </p>
    </header>

    <section class="mb-10">
      <Callout client:load variant="info" title="사용 방법">
        <ul class="list-disc list-inside mt-2 text-sm space-y-1">
          <li>하루에 과제 1개만 수행하세요.</li>
          <li>각 미션은 "산출물"과 "완료 기준"을 충족하면 종료합니다.</li>
          <li>막히면 해당 미션 카드의 문제 해결/레시피 링크로 바로 이동하세요.</li>
        </ul>
      </Callout>
    </section>

    <section class="mb-10">
      <PromptBox
        client:load
        title="매일 시작할 때 쓰는 기본 프롬프트"
        description="같은 형식으로 질문하면 하루 과제의 범위가 흔들리지 않습니다."
        prompt={`너는 초보 개발자를 돕는 시니어 엔지니어다.
현재 내 과제는 Choorai 2주 완주 미션 중 하나이며, 목표는 오늘 과제를 끝내는 것이다.
아래 형식으로만 답해줘:
1) 지금 해야 할 작업 3개
2) 복붙 가능한 명령어/코드
3) 완료 기준 체크리스트
4) 실패했을 때 확인할 순서(최대 3단계)

모호한 설명 대신 바로 실행 가능한 결과만 제시해줘.`}
      />
    </section>

    <section class="mb-10">
      <Checklist
        client:load
        storageKey="mission-2week-v2"
        title="2주 완주 진행 현황"
        items={checklistItems}
      />
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-white mb-4">1주차: 첫 배포까지</h2>
      <div class="space-y-4">
        {week1.map((mission) => (
          <article class="p-5 bg-surface border border-border rounded-xl">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-2 py-0.5 bg-primary/15 text-primary text-xs font-bold rounded">{mission.day}</span>
              <h3 class="text-white font-bold">{mission.title}</h3>
              <span class="text-xs text-text-secondary">({mission.duration})</span>
            </div>

            <p class="text-text-secondary text-sm mb-4"><strong class="text-white">목표:</strong> {mission.goal}</p>

            <div class="grid md:grid-cols-2 gap-4 mb-4">
              <div>
                <h4 class="text-sm font-bold text-white mb-2">실행 단계</h4>
                <ol class="list-decimal list-inside text-sm text-text-secondary space-y-1">
                  {mission.steps.map((item) => (
                    <li>{item}</li>
                  ))}
                </ol>
              </div>
              <div>
                <h4 class="text-sm font-bold text-white mb-2">완료 기준</h4>
                <ul class="list-disc list-inside text-sm text-text-secondary space-y-1">
                  {mission.done.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="space-y-3 mb-4">
              <p class="text-text-secondary text-sm"><strong class="text-white">산출물:</strong> {mission.output}</p>
              <p class="text-text-secondary text-sm"><strong class="text-white">검증 방법:</strong> {mission.validation}</p>
              <div>
                <h4 class="text-sm font-bold text-white mb-2">AI 시작 프롬프트</h4>
                <pre class="whitespace-pre-wrap break-words rounded-lg bg-background border border-border p-3 text-xs text-text-secondary leading-relaxed">{mission.starterPrompt}</pre>
              </div>
            </div>

            <div class="flex flex-wrap gap-2">
              {mission.links.map((link) => (
                <a href={link.href} class="px-3 py-1.5 text-xs font-medium rounded-lg bg-background border border-border text-text-secondary hover:text-white hover:border-primary/40 transition-colors">
                  {link.label}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-white mb-4">2주차: 안정화와 데모 정리</h2>
      <div class="space-y-4">
        {week2.map((mission) => (
          <article class="p-5 bg-surface border border-border rounded-xl">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-2 py-0.5 bg-accent-purple/20 text-accent-purple text-xs font-bold rounded">{mission.day}</span>
              <h3 class="text-white font-bold">{mission.title}</h3>
              <span class="text-xs text-text-secondary">({mission.duration})</span>
            </div>

            <p class="text-text-secondary text-sm mb-4"><strong class="text-white">목표:</strong> {mission.goal}</p>

            <div class="grid md:grid-cols-2 gap-4 mb-4">
              <div>
                <h4 class="text-sm font-bold text-white mb-2">실행 단계</h4>
                <ol class="list-decimal list-inside text-sm text-text-secondary space-y-1">
                  {mission.steps.map((item) => (
                    <li>{item}</li>
                  ))}
                </ol>
              </div>
              <div>
                <h4 class="text-sm font-bold text-white mb-2">완료 기준</h4>
                <ul class="list-disc list-inside text-sm text-text-secondary space-y-1">
                  {mission.done.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="space-y-3 mb-4">
              <p class="text-text-secondary text-sm"><strong class="text-white">산출물:</strong> {mission.output}</p>
              <p class="text-text-secondary text-sm"><strong class="text-white">검증 방법:</strong> {mission.validation}</p>
              <div>
                <h4 class="text-sm font-bold text-white mb-2">AI 시작 프롬프트</h4>
                <pre class="whitespace-pre-wrap break-words rounded-lg bg-background border border-border p-3 text-xs text-text-secondary leading-relaxed">{mission.starterPrompt}</pre>
              </div>
            </div>

            <div class="flex flex-wrap gap-2">
              {mission.links.map((link) => (
                <a href={link.href} class="px-3 py-1.5 text-xs font-medium rounded-lg bg-background border border-border text-text-secondary hover:text-white hover:border-primary/40 transition-colors">
                  {link.label}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <Callout client:load variant="tip" title="이 과정이 기존 Map과 다른 점">
        <ul class="list-disc list-inside mt-2 text-sm space-y-1">
          <li>기술 주제가 아니라 완성 산출물 중심으로 순서가 고정됩니다.</li>
          <li>각 단계의 종료 조건이 명확해서 중간에 멈추기 어렵습니다.</li>
          <li>실패했을 때 바로 이동할 문제 해결/레시피 문서를 포함합니다.</li>
        </ul>
      </Callout>
    </section>

    <PageNavigation currentPath="/path/mission" />
  </div>
</DocsLayout>
