---
import DocsLayout from '../../../../layouts/DocsLayout.astro';
import ChallengeCompletionSummary from '../../../../components/ChallengeCompletionSummary';
import Callout from '../../../../components/Callout';
import PageNavigation from '../../../../components/PageNavigation.astro';

const nextSteps = [
  {
    title: '백엔드 배포하기',
    description: 'Cloud Run으로 API 서버를 인터넷에 배포하세요',
    href: '/deploy/cloud-run',
    icon: 'cloud',
  },
  {
    title: '데이터베이스 연결',
    description: 'PostgreSQL로 데이터를 영구 저장하세요',
    href: '/map/database',
    icon: 'database',
  },
  {
    title: '사용자 인증 추가',
    description: '로그인/회원가입 기능을 구현하세요',
    href: '/map/auth',
    icon: 'lock',
  },
  {
    title: '학습 사이클 계속하기',
    description: '더 깊이 있는 개발 지식을 쌓으세요',
    href: '/map',
    icon: 'school',
  },
];
---

<DocsLayout
  title="60분 완주 · 실제 진도 확인"
  description="브라우저에 저장된 60분 학습 체크리스트의 완료 표시를 확인합니다"
  currentPath="/start/60min/complete"
>
  <div class="max-w-4xl mx-auto px-6 py-8">
    <ChallengeCompletionSummary client:load locale="ko" />

    <!-- 다음 단계 -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-white mb-6">다음 단계</h2>
      <div class="grid md:grid-cols-2 gap-4">
        {nextSteps.map((step) => (
          <a
            href={step.href}
            class="group flex items-start gap-4 p-4 bg-surface border border-border rounded-xl hover:border-primary/50 transition-all hover:-translate-y-1 no-underline"
          >
            <div class="p-3 rounded-lg bg-primary/10 text-primary group-hover:bg-primary/20 transition-colors">
              {step.icon === 'cloud' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                </svg>
              )}
              {step.icon === 'database' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                </svg>
              )}
              {step.icon === 'lock' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              )}
              {step.icon === 'school' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="font-bold text-white group-hover:text-primary transition-colors">{step.title}</h3>
              <p class="text-sm text-text-secondary mt-1">{step.description}</p>
            </div>
            <svg class="w-5 h-5 text-text-secondary ml-auto self-center group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- 피드백 -->
    <section class="mb-12">
      <Callout client:load variant="info" title="피드백을 남겨주세요">
        <p class="text-sm">
          60분 완주 튜토리얼이 도움이 되었나요? 개선할 점이 있다면 알려주세요.
          <br />
          <a href="https://github.com/choorai/choorai/issues" class="text-primary hover:underline">GitHub Issues</a>에서
          피드백을 남기거나 질문할 수 있습니다.
        </p>
      </Callout>
    </section>

    <!-- 네비게이션 -->
    <PageNavigation currentPath="/start/60min/complete" />
  </div>
</DocsLayout>
