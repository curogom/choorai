---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Callout from '../../../components/Callout';
import PromptBox from '../../../components/PromptBox';
import Checklist from '../../../components/Checklist';
import PageNavigation from '../../../components/PageNavigation.astro';

const stages = [
  {
    id: 'harness',
    day: 'Day 1',
    duration: '60-90 min',
    title: '1. AI Harness',
    href: '/en/map/ai/harness',
    recipeHref: '/en/recipes/make-eval-harness',
    badge: 'Quality baseline',
    description: 'Validate repeatable behavior before arguing about whether a prompt feels good.',
    outputs: ['20 golden cases', 'grading rules', 'failure report'],
    done: ['20 core questions are selected', 'Pass/fail rules are written', 'Failed cases are captured in a report'],
    validation: 'Run the same inputs again and confirm pass/fail judgment stays consistent.',
    prompt: 'I want to create an eval harness before shipping my AI feature. Please draft 20 core user questions, pass criteria, forbidden behavior, and a failure report format.',
  },
  {
    id: 'rag',
    day: 'Day 2',
    duration: '90-120 min',
    title: '2. Mini RAG',
    href: '/en/map/ai/rag-basics',
    recipeHref: '/en/recipes/add-mini-rag',
    badge: 'Knowledge link',
    description: 'Ingest documents, retrieve relevant chunks, and return cited answers.',
    outputs: ['document intake', 'chunking/embeddings', 'search API'],
    done: ['3-10 documents are collected', 'The search API returns evidence chunks', 'Answers include citations'],
    validation: 'Treat uncited answers as failures and confirm the response includes source document titles.',
    prompt: 'I want to add mini RAG to an existing service. Please outline document intake, chunking, search API, cited responses, and failure policy in the smallest implementation order.',
  },
  {
    id: 'skill',
    day: 'Day 3',
    duration: '60-90 min',
    title: '3. Skill / Tool',
    href: '/en/map/ai/skills',
    recipeHref: '/en/recipes/write-project-skill',
    badge: 'Repeated work',
    description: 'Turn repeated operating procedures into reusable skills with clear tool boundaries.',
    outputs: ['SKILL.md', 'I/O contract', 'validation command'],
    done: ['One repeated task is selected', 'SKILL.md includes trigger, inputs, procedure, and validation', 'Tool permission boundaries are defined'],
    validation: 'Start a new chat and confirm the procedure can be reproduced from the skill alone.',
    prompt: 'I want to turn one repeated project workflow into a Codex Skill. Please draft SKILL.md with trigger, inputs, procedure, files to read, validation commands, and recovery steps.',
  },
  {
    id: 'local-llm',
    day: 'Day 4',
    duration: '60-120 min',
    title: '4. Local LLM',
    href: '/en/map/ai/local-llm',
    recipeHref: '/en/recipes/run-local-llm',
    badge: 'Model optionality',
    description: 'Use Ollama for quick local experiments and vLLM for server-style inference.',
    outputs: ['base URL switch', 'quality/cost table', 'rollback rule'],
    done: ['Hosted API vs local switching criteria are defined', 'Ollama or vLLM response is verified once', 'Quality/cost/ops table is written'],
    validation: 'Run the Day 1 harness with the same inputs and compare model behavior before and after the switch.',
    prompt: 'I want to compare Hosted API, Ollama, and vLLM for my AI feature. Please create a quality, cost, privacy, ops difficulty, rollback criteria table and a validation sequence.',
  },
];

const checklistItems = stages.map((stage) => ({
  id: stage.id,
  label: `${stage.day} · ${stage.title}`,
  description: stage.outputs.join(' / '),
}));

const builderPrompt = `You are a senior engineer helping ship AI product features.
My goal is to complete a minimal AI feature in 4 days with an eval harness, mini RAG, project Skill, and Local LLM decision criteria.
Reply only in this structure:
1) Output to finish today
2) 3-5 implementation steps
3) Copy-paste files/commands/checklist
4) Debugging order if it fails
5) Done criteria and next step`;
---

<DocsLayout
  lang="en"
  title="AI Service Builder"
  description="Extend a real service with RAG, eval harnesses, skills, and local LLM options"
  currentPath="/path/ai-builder"
>
  <div class="max-w-4xl mx-auto px-6 py-8">
    <nav class="flex items-center gap-2 text-sm text-text-secondary mb-6" aria-label="Breadcrumb">
      <a href="/en" class="hover:text-white transition-colors">Home</a>
      <span>/</span>
      <a href="/en/path" class="hover:text-white transition-colors">Path</a>
      <span>/</span>
      <span class="text-primary font-medium">AI Service Builder</span>
    </nav>

    <header class="mb-8 pb-6 border-b border-border">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-300 text-xs font-bold mb-4">
        Advanced Path
      </div>
      <h1 class="text-3xl md:text-4xl font-black text-white mb-4">AI Service Builder</h1>
      <p class="text-text-secondary text-lg leading-relaxed">
        Once you have shipped a deploy URL, the next step is putting AI features inside the product.
        This course connects RAG, eval harnesses, skills, and local LLMs into one operable feature path.
      </p>
    </header>

    <section class="mb-10">
      <Callout client:load locale="en" variant="tip" title="Done criteria">
        <p class="mt-2 text-sm">
          You are done when you can explain input data, retrieval evidence, model response, eval result, and fallback path.
        </p>
      </Callout>
    </section>

    <section class="mb-10">
      <PromptBox
        client:load
        locale="en"
        title="AI Builder Starter Prompt"
        description="Use this with each day-specific prompt to keep scope stable."
        prompt={builderPrompt}
      />
    </section>

    <section class="mb-10">
      <Checklist
        client:load
        storageKey="ai-builder-4day-v1-en"
        title="AI Builder 4-day progress"
        locale="en"
        items={checklistItems}
      />
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-white mb-4">4-Day Execution Mission</h2>
      <div class="space-y-4">
        {stages.map((stage) => (
          <article class="p-5 bg-surface border border-border rounded-xl">
            <div class="flex flex-wrap items-center gap-2 mb-3">
              <span class="px-2 py-0.5 rounded bg-primary/15 text-primary text-xs font-bold">{stage.day}</span>
              <h3 class="text-white font-bold">{stage.title}</h3>
              <span class="text-xs text-text-secondary">({stage.duration})</span>
              <span class="px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 text-xs font-bold">{stage.badge}</span>
            </div>
            <p class="text-text-secondary text-sm mb-4">{stage.description}</p>

            <div class="grid md:grid-cols-2 gap-4 mb-4">
              <div>
                <h4 class="text-sm font-bold text-white mb-2">Outputs</h4>
                <div class="flex flex-wrap gap-2">
                  {stage.outputs.map((output) => (
                    <span class="px-2 py-1 bg-background/60 text-text-secondary text-xs rounded">{output}</span>
                  ))}
                </div>
              </div>
              <div>
                <h4 class="text-sm font-bold text-white mb-2">Done Criteria</h4>
                <ul class="list-disc list-inside text-sm text-text-secondary space-y-1">
                  {stage.done.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="space-y-3 mb-4">
              <p class="text-text-secondary text-sm"><strong class="text-white">Validation:</strong> {stage.validation}</p>
              <div>
                <h4 class="text-sm font-bold text-white mb-2">AI Starter Prompt</h4>
                <pre class="whitespace-pre-wrap break-words rounded-lg bg-background border border-border p-3 text-xs text-text-secondary leading-relaxed">{stage.prompt}</pre>
              </div>
            </div>

            <div class="flex flex-wrap gap-2">
              <a href={stage.href} class="px-3 py-1.5 text-xs font-medium rounded-lg bg-background border border-border text-text-secondary hover:text-white hover:border-primary/40 transition-colors">
                Read Concept
              </a>
              <a href={stage.recipeHref} class="px-3 py-1.5 text-xs font-medium rounded-lg bg-primary text-background hover:bg-primary-hover transition-colors">
                Run Recipe
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-white mb-4">Recommended Outputs</h2>
      <div class="p-5 bg-surface border border-border rounded-xl">
        <ul class="list-disc list-inside text-text-secondary space-y-2">
          <li>A minimum API such as <strong class="text-white">/ai/ask</strong></li>
          <li>An eval baseline such as <strong class="text-white">docs/ai-evals.md</strong> or <strong class="text-white">evals/*.json</strong></li>
          <li>A RAG failure policy: answer unknown when evidence is missing</li>
          <li>A model routing table: Hosted API, Ollama, or vLLM by scenario</li>
        </ul>
      </div>
    </section>

    <section class="mb-10">
      <Callout client:load locale="en" variant="info" title="Runnable Recipes">
        <div class="grid sm:grid-cols-2 gap-3 mt-3 text-sm">
          <a href="/en/recipes/make-eval-harness" class="text-primary hover:underline">Make an Eval Harness</a>
          <a href="/en/recipes/add-mini-rag" class="text-primary hover:underline">Add Mini RAG</a>
          <a href="/en/recipes/write-project-skill" class="text-primary hover:underline">Write a Project Skill</a>
          <a href="/en/recipes/run-local-llm" class="text-primary hover:underline">Run a Local LLM</a>
        </div>
      </Callout>
    </section>

    <PageNavigation currentPath="/path/ai-builder" lang="en" />
  </div>
</DocsLayout>
