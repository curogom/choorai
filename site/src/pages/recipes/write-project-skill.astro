---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Callout from '../../components/Callout';
import CodeBlock from '../../components/CodeBlock';
import PromptBox from '../../components/PromptBox';
import Checklist from '../../components/Checklist';
import TemplateSections from '../../components/TemplateSections.astro';

const prompt = `이 프로젝트의 반복 업무를 AI Skill로 만들고 싶어.
아래 정보를 바탕으로 SKILL.md 초안을 작성해줘.

[반복 업무]
- 업무 이름: [예: 릴리즈 준비]
- 언제 실행하는가: [예: 배포 전]
- 입력값: [예: 브랜치, 배포 환경, 변경 요약]
- 읽어야 할 파일/문서: [예: package.json, README, docs/deploy.md]
- 실행해야 할 명령: [예: npm run build, npm test]
- 실패 시 복구 기준: [예: 빌드 실패면 로그 분석 후 중단]

[출력 요구사항]
1) Skill 목적
2) Trigger 조건
3) 절차
4) 검증 명령
5) 금지 행동과 승인 필요 행동
6) 예시 요청 문장`;

const checklist = [
  { id: 'repeat', label: '반복성 확인', description: '세 번 이상 반복되는 업무인지 확인' },
  { id: 'trigger', label: '트리거 작성', description: '언제 Skill을 써야 하는지 명확화' },
  { id: 'scope', label: '읽기/쓰기 범위 제한', description: '필요한 파일과 시스템만 지정' },
  { id: 'validation', label: '검증 명령 작성', description: '성공/실패를 판단할 명령 포함' },
  { id: 'approval', label: '승인 경계 작성', description: '배포/삭제/외부 전송은 승인 필요' },
];

const skeleton = `# Skill Name

## Purpose

## When to use

## Inputs

## Procedure

## Validation

## Safety`;
---

<DocsLayout
  title="레시피: 프로젝트 Skill 작성"
  description="반복 업무를 AI가 재사용할 수 있는 Skill 문서로 정리하는 프롬프트"
  currentPath="/recipes/write-project-skill"
>
  <div class="max-w-4xl mx-auto px-6 py-8">
    <nav class="flex items-center gap-2 text-sm text-text-secondary mb-6" aria-label="현재 위치">
      <a href="/" class="hover:text-white transition-colors">홈</a>
      <span>/</span>
      <a href="/recipes" class="hover:text-white transition-colors">Recipes</a>
      <span>/</span>
      <span class="text-primary font-medium">프로젝트 Skill 작성</span>
    </nav>

    <header class="mb-8 pb-6 border-b border-border">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-300 text-xs font-bold mb-4">
        AI Extension · Workflow
      </div>
      <h1 class="text-3xl md:text-4xl font-black text-white mb-4">프로젝트 Skill 작성</h1>
      <p class="text-text-secondary text-lg leading-relaxed">
        반복 업무를 매번 프롬프트로 설명하지 않고, 절차와 검증 기준을 Skill 문서로 고정합니다.
      </p>
    </header>

    <section class="mb-8">
      <Callout client:load variant="tip" title="Skill 후보">
        <p class="mt-2">릴리즈, PR 리뷰, 배포 점검, 문서 업데이트, 고객 문의 분류처럼 반복되는 업무부터 시작하세요.</p>
      </Callout>
    </section>

    <section class="mb-10">
      <PromptBox client:load prompt={prompt} title="프로젝트 Skill 작성 프롬프트" />
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-white mb-4">SKILL.md 뼈대</h2>
      <CodeBlock client:load filename="SKILL.md" code={skeleton} />
    </section>

    <section class="mb-10">
      <Checklist client:load storageKey="recipe-write-project-skill" title="실행 체크리스트" items={checklist} />
    </section>

    <TemplateSections topic="write-project-skill" />

    <section class="mt-12 pt-8 border-t border-border">
      <h3 class="text-lg font-bold text-white mb-4">관련 문서</h3>
      <div class="grid md:grid-cols-2 gap-4">
        <a href="/map/ai/skills" class="p-4 bg-surface border border-border rounded-lg hover:border-primary/50 transition-colors no-underline">
          <h4 class="text-white font-medium mb-1">AI Skills</h4>
          <p class="text-text-secondary text-sm">Skill과 Tool/MCP 차이</p>
        </a>
        <a href="/map/ops/release-rollback" class="p-4 bg-surface border border-border rounded-lg hover:border-primary/50 transition-colors no-underline">
          <h4 class="text-white font-medium mb-1">릴리즈/롤백 런북</h4>
          <p class="text-text-secondary text-sm">운영 절차를 Skill로 전환</p>
        </a>
      </div>
    </section>
  </div>
</DocsLayout>
