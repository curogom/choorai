---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Callout from '../../components/Callout';
import CodeBlock from '../../components/CodeBlock';
import PromptBox from '../../components/PromptBox';
import Checklist from '../../components/Checklist';
import TemplateSections from '../../components/TemplateSections.astro';

const prompt = `이 프로젝트에서 Local LLM을 실험하고 싶어.
Ollama와 vLLM을 비교하는 실행 계획을 만들어줘.

[프로젝트 정보]
- 현재 LLM 호출 방식: [OpenAI SDK/HTTP 직접 호출/기타]
- 실험할 기능: [예: 문서 QA, 요약, 분류]
- 로컬 장비/서버: [Mac/GPU 서버/없음]
- 중요 기준: [품질/비용/속도/보안/오프라인]

[출력 요구사항]
1) Ollama 빠른 실험 절차
2) vLLM 서버 실험 절차
3) OpenAI 호환 base URL 전환 방식
4) 평가 하네스 실행 기준
5) Hosted API로 롤백하는 기준`;

const checklist = [
  { id: 'feature', label: '실험 기능 고정', description: '한 기능과 평가 케이스로 제한' },
  { id: 'ollama', label: 'Ollama 스모크 테스트', description: '로컬 OpenAI 호환 엔드포인트 확인' },
  { id: 'vllm', label: 'vLLM 서버 테스트', description: 'GPU 서버/포트/모델명을 기록' },
  { id: 'switch', label: 'base URL 전환', description: '환경변수로 모델 공급자 교체' },
  { id: 'rollback', label: '롤백 기준 작성', description: '품질/지연/오류율 기준 미달 시 복귀' },
];

const envExample = `OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
AI_MODEL=llama3.1`;
---

<DocsLayout
  title="레시피: Local LLM 실행"
  description="Ollama와 vLLM을 OpenAI 호환 API로 실험하는 프롬프트"
  currentPath="/recipes/run-local-llm"
>
  <div class="max-w-4xl mx-auto px-6 py-8">
    <nav class="flex items-center gap-2 text-sm text-text-secondary mb-6" aria-label="현재 위치">
      <a href="/" class="hover:text-white transition-colors">홈</a>
      <span>/</span>
      <a href="/recipes" class="hover:text-white transition-colors">Recipes</a>
      <span>/</span>
      <span class="text-primary font-medium">Local LLM 실행</span>
    </nav>

    <header class="mb-8 pb-6 border-b border-border">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-300 text-xs font-bold mb-4">
        AI Extension · Inference
      </div>
      <h1 class="text-3xl md:text-4xl font-black text-white mb-4">Local LLM 실행</h1>
      <p class="text-text-secondary text-lg leading-relaxed">
        로컬 모델은 “무료”라서가 아니라 비용, 보안, 오프라인, 모델 선택권을 실험하기 위해 사용합니다.
      </p>
    </header>

    <section class="mb-8">
      <Callout client:load variant="warning" title="하네스와 같이 실행">
        <p class="mt-2">모델만 바꾸면 품질 판단이 흔들립니다. 같은 평가 케이스로 Hosted API, Ollama, vLLM을 비교하세요.</p>
      </Callout>
    </section>

    <section class="mb-10">
      <PromptBox client:load prompt={prompt} title="Local LLM 실험 프롬프트" />
    </section>

    <section class="mb-10">
      <h2 class="text-2xl font-bold text-white mb-4">환경변수 전환 예시</h2>
      <CodeBlock client:load filename=".env.local" code={envExample} />
    </section>

    <section class="mb-10">
      <Checklist client:load storageKey="recipe-run-local-llm" title="실행 체크리스트" items={checklist} />
    </section>

    <TemplateSections topic="run-local-llm" />

    <section class="mt-12 pt-8 border-t border-border">
      <h3 class="text-lg font-bold text-white mb-4">관련 문서</h3>
      <div class="grid md:grid-cols-2 gap-4">
        <a href="/map/ai/local-llm" class="p-4 bg-surface border border-border rounded-lg hover:border-primary/50 transition-colors no-underline">
          <h4 class="text-white font-medium mb-1">Local LLM</h4>
          <p class="text-text-secondary text-sm">Ollama/vLLM 선택 기준</p>
        </a>
        <a href="/map/ai/harness" class="p-4 bg-surface border border-border rounded-lg hover:border-primary/50 transition-colors no-underline">
          <h4 class="text-white font-medium mb-1">AI 하네스</h4>
          <p class="text-text-secondary text-sm">모델 변경 품질 평가</p>
        </a>
      </div>
    </section>
  </div>
</DocsLayout>
